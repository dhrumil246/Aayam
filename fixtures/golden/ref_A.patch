@@ -2888,6 +2898,24 @@ class Parameter(ABC):
         return self.type.shell_complete(ctx, self, incomplete)
 
 
+
+def _option_matches_conflict(param: Parameter, target: str) -> bool:
+    if target == param.name or target in param.opts or target in param.secondary_opts:
+        return True
+    dashed = f"--{target.replace('_', '-')}"
+    return dashed in param.opts or f"-{target}" in param.opts
+
+
+def _options_conflict(a: Parameter, b: Parameter) -> bool:
+    if a is b:
+        return False
+    a_cw = getattr(a, "conflicts_with", ())
+    b_cw = getattr(b, "conflicts_with", ())
+    return any(_option_matches_conflict(b, t) for t in a_cw) or any(
+        _option_matches_conflict(a, t) for t in b_cw
+    )
+
